# Copy to .env.local and fill in. .env.local is gitignored — never commit real
# credentials, and never paste them into a chat or an issue.

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# DATABASE_URL  — what the app uses at runtime.
# DIRECT_URL    — what migrations and drizzle-kit use.
#
# On Supabase these are different connection strings, and using the wrong one
# is a common cause of confusing failures:
#
#   DATABASE_URL -> Connection Pooling / Transaction mode, port 6543
#                   Serverless functions open and drop connections constantly;
#                   the pooler is what keeps the free tier's connection cap
#                   from being exhausted.
#
#   DIRECT_URL   -> Direct connection, port 5432
#                   DDL and advisory locks misbehave under transaction-mode
#                   pooling, so migrations must not go through the pooler.
#
# Both are in the Supabase dashboard under Project Settings > Database.

DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require"

# Local mirror. Point both at this to run entirely offline — nothing else in
# the app changes.
# DATABASE_URL="postgresql://postgres:<password>@localhost:5432/dse_research"
# DIRECT_URL="postgresql://postgres:<password>@localhost:5432/dse_research"

# -----------------------------------------------------------------------------
# Supabase, kept alongside the local pair rather than replacing it
# -----------------------------------------------------------------------------
# Scripts take --target=supabase to use these, so there is no swapping a single
# variable back and forth and no migrating the wrong database by accident.
#
# Dashboard > Connect > Connection string:
#   SUPABASE_DATABASE_URL  <- "Transaction pooler", port 6543
#   SUPABASE_DIRECT_URL    <- "Session pooler",     port 5432
#
# Prefer the session pooler over "Direct connection": the latter is IPv6-only
# without the IPv4 add-on, while the session pooler is IPv4 and still runs in
# session mode, which DDL needs.

SUPABASE_DATABASE_URL=""
SUPABASE_DIRECT_URL=""

# -----------------------------------------------------------------------------
# Auth (single user) — REQUIRED, including on Vercel
# -----------------------------------------------------------------------------
# Every page is behind a login. This app edits a database; an unauthenticated
# visitor could otherwise overwrite hand-entered financial history.
#
# Both must be set or the app fails closed — it refuses logins rather than
# running unprotected.

AUTH_PASSWORD=""          # at least 8 characters

# Signs the session cookie; at least 32 characters. Changing it signs you out.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# -----------------------------------------------------------------------------
# Scheduled jobs
# -----------------------------------------------------------------------------
# Bearer secret the daily price job must present. /api/cron/* sits outside the
# login wall (a cron request carries no cookie), so without this it would be a
# public write path into your database. Vercel sends this header automatically
# when CRON_SECRET is set on the project.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=""

# -----------------------------------------------------------------------------
# Backup and restore
# -----------------------------------------------------------------------------
# Directory holding pg_dump and psql. Only needed if they are not on PATH.
# The Windows installer does not add them, and may not use the default path.
PG_BIN=""

# System alerts (Web Push). Generate a pair with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# The public key is shared with browsers; keep the private key secret.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A URL (or mailto:) identifying the sender to push services.
VAPID_SUBJECT=https://your-app.vercel.app
